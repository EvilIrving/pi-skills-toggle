{
  "name": "@light-cat/pi-skills-toggle",
  "version": "1.0.0",
  "description": "Per-project exclude/include of global Pi skills via local shadow stubs",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "skills"
  ],
  "author": "EvilIrving <dong.yy1916@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvilIrving/pi-skills-toggle.git"
  },
  "bugs": {
    "url": "https://github.com/EvilIrving/pi-skills-toggle/issues"
  },
  "homepage": "https://github.com/EvilIrving/pi-skills-toggle#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "index.ts",
    "logic.ts",
    "ui.ts",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "prepack": "npm test && npm run smoke && npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typescript": "^5.7.3"
  }
}
