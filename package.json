  "keywords": [
    "pi-package",
    "pi-extension",
    "skills"
  ],
  "author": "EvilIrving <dong.yy1916@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvilIrving/pi-project-skill-toggle.git"
  },
  "bugs": {
    "url": "https://github.com/EvilIrving/pi-project-skill-toggle/issues"
  },
  "homepage": "https://github.com/EvilIrving/pi-project-skill-toggle#readme",
  "files": [
    "index.ts",
    "logic.ts",
    "ui.ts",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
