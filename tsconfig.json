{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "baseUrl": "."
  },
  "include": ["index.ts", "logic.ts", "ui.ts"],
  "exclude": ["node_modules", "tests", "scripts"]
}
